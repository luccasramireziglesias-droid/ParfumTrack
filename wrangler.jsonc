{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parfumtrack",
  "main": "worker.js",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "FROM_EMAIL": "parfumtrack@gmail.com",
    "FROM_NAME": "Parfum Track"
  }
}
