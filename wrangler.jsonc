{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parfumtrack",
  "main": "worker.js",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "FROM_EMAIL": "luccasramireziglesias@gmail.com",
    "FROM_NAME": "Parfum Track",
    // URL pública del Worker — actualizar en Cloudflare Dashboard → Workers → parfumtrack → Settings → Variables
    // Ejemplo: https://parfumtrack.tusubdominio.workers.dev  (ver en CF Dashboard → Workers & Pages → parfumtrack → Domains & Routes)
    "APP_URL": "https://parfumtrack.workers.dev",
    // Moneda de Mercado Pago según tu cuenta (ARS=Argentina, UYU=Uruguay, CLP=Chile, USD=Internacional)
    // Cambiar según el país de tu cuenta MP. Secrets: MP_ACCESS_TOKEN y MP_WEBHOOK_SECRET en Dashboard.
    "MP_CURRENCY_ID": "ARS",
    // Montos en la moneda configurada arriba
    "MP_AMOUNT_MONTHLY": "9.99",
    "MP_AMOUNT_ANNUAL": "95.88"
  },
  // KV namespace para licencias.
  // Para obtener el ID: npx wrangler kv namespace create PT_LICENSES
  "kv_namespaces": [
    {
      "binding": "PT_LICENSES",
      "id": "412577285b984e42a7e230dfabcd0a27"
    }
  ],
  // R2 bucket para backups en la nube.
  "r2_buckets": [
    {
      "binding": "PT_BACKUP",
      "bucket_name": "parfumtrack-backups"
    }
  ]
}
