{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parfumtrack",
  "main": "worker.js",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "FROM_EMAIL": "parfumtrack@gmail.com",
    "FROM_NAME": "Parfum Track"
  },
  // KV namespace para licencias.
  // Para obtener el ID: npx wrangler kv namespace create PT_LICENSES
  "kv_namespaces": [
    {
      "binding": "PT_LICENSES",
      "id": "412577285b984e42a7e230dfabcd0a27"
    }
  ],
  // R2 bucket para backups en la nube.
  "r2_buckets": [
    {
      "binding": "PT_BACKUP",
      "bucket_name": "parfumtrack-backups"
    }
  ]
}
